    { "band": "Outstanding", "min": 4.50, "max": 5.00 },
    { "band": "Exceeds Expectations", "min": 3.50, "max": 4.49 },
    { "band": "Meets Expectations", "min": 2.50, "max": 3.49 },
    { "band": "Below Expectations", "min": 1.50, "max": 2.49 },
    { "band": "Unsatisfactory", "min": 0.00, "max": 1.49 }
  ],
  "approval_stages": [
    { "stage": 1, "name": "Employee", "action": "Submit Self-Assessment & Evidence" },
