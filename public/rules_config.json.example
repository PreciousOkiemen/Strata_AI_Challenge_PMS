    { "stage": 5, "name": "Chief of Staff", "action": "Policy Compliance Review" },
    { "stage": 6, "name": "CEO", "action": "Final Approval" }
  ],
  "required_sign_offs": ["Employee", "Line Manager", "Overall Manager", "CEO"],
  "notification_routing": {
    "unsatisfactory_recipient": "Chief of Staff / HR",
    "standard_recipient": "Line Manager"
  },
